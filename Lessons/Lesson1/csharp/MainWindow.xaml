<Window x:Class="Lesson1Host.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lesson1 上位机（TCP 客户端）" Width="560" Height="460">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 连接区 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="IP" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtIp" Text="127.0.0.1" Width="110" Margin="6,0"/>
            <TextBlock Text="端口" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtPort" Text="12000" Width="60" Margin="6,0"/>
            <Button x:Name="BtnConnect" Content="连接" Width="70" Click="BtnConnect_Click"/>
            <TextBlock x:Name="TxtConnState" Text="未连接" VerticalAlignment="Center" Margin="12,0,0,0"/>
        </StackPanel>

        <!-- 命令区 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="轴" VerticalAlignment="Center"/>
            <ComboBox x:Name="CmbAxis" Width="60" Margin="6,0" SelectedIndex="0">
                <ComboBoxItem Content="X"/>
                <ComboBoxItem Content="Y"/>
                <ComboBoxItem Content="Z"/>
            </ComboBox>
            <TextBlock Text="目标位置" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtPos" Text="100" Width="70" Margin="6,0"/>
            <TextBlock Text="速度" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtVel" Text="50" Width="60" Margin="6,0"/>
            <Button Content="MOVE" Width="60" Click="BtnMove_Click"/>
            <Button Content="MOVE XYZ" Width="80" Margin="6,0,0,0" Click="BtnMoveAll_Click"/>
            <Button Content="STOP" Width="60" Margin="6,0,0,0" Click="BtnStop_Click"/>
        </StackPanel>

        <!-- 三轴状态 -->
        <Border Grid.Row="2" BorderBrush="Gray" BorderThickness="1" Padding="8" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="TxtAxisX" Text="X : ---"/>
                <TextBlock x:Name="TxtAxisY" Text="Y : ---" Margin="30,0,0,0"/>
                <TextBlock x:Name="TxtAxisZ" Text="Z : ---" Margin="30,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- 日志 -->
        <TextBox x:Name="TxtLog" Grid.Row="3" IsReadOnly="True"
                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/>
    </Grid>
</Window>
